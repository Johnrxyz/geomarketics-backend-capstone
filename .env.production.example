# PythonAnywhere pilot configuration example.
# Keep the actual .env file private and replace every placeholder on the host.
# The checked-in PythonAnywhere WSGI template explicitly selects pilot settings.
DJANGO_SETTINGS_MODULE=core.settings.pilot

# Generate a unique random value of at least 50 characters on the host.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters

# Exact hostnames only: no scheme, wildcard, port, or path.
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Exact HTTPS frontend origins only: no wildcard, port, or path.
CORS_ALLOWED_ORIGINS=https://your-vercel-project-url.vercel.app

# Private vendor-document and complaint-evidence storage.
DOCUMENT_STORAGE_BACKEND=cloudinary
DOCUMENT_PROCESSING_MODE=manual
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# SMS is deferred for the pilot. Do not configure Semaphore credentials.
