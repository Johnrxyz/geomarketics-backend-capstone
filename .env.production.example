# PythonAnywhere supervised pilot environment variables.
# Copy to .env on the server, replace every placeholder, and keep the file private.
# The live WSGI file sets DJANGO_SETTINGS_MODULE directly; changing this sample
# value alone will not activate pilot.py. Follow the Phase 2D activation steps.
DJANGO_SETTINGS_MODULE=core.settings.pilot

# Generate a unique key on the server; this placeholder is intentionally rejected.
SECRET_KEY=replace-with-a-unique-random-secret

# Exact hostnames only: no scheme, wildcard, port, or path.
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Exact HTTPS origins only: no wildcard, port, or path.
CORS_ALLOWED_ORIGINS=https://your-vercel-project-url.vercel.app

# pilot.py always uses the existing BASE_DIR/db.sqlite3 file; no DB_* override is read.

GEMINI_API_KEY="your_api_key_here"

# -------------------------------------------------------
# Semaphore SMS Gateway (https://semaphore.co)
# -------------------------------------------------------
# Required for SMS admin notifications on new complaints.
SEMAPHORE_API_KEY=your_semaphore_api_key_here
# Sender name must be pre-registered with Semaphore (max 11 characters).
SEMAPHORE_SENDER_NAME=ePalengke
